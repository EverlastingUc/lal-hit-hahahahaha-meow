{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reddit-achievements.schema.json",
  "title": "Reddit Achievement Record",
  "type": "object",
  "required": [
    "id",
    "name",
    "system",
    "category",
    "description",
    "unlock",
    "status",
    "availability",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "system": {
      "enum": [
        "achievement",
        "trophy",
        "award",
        "legacy_trophy",
        "legacy_achievement"
      ]
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "unlock": {
      "type": "object",
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "metric",
              "operator"
            ],
            "properties": {
              "metric": {
                "type": "string"
              },
              "operator": {
                "type": "string"
              },
              "value": {},
              "unit": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "status": {
      "enum": [
        "official",
        "community",
        "historical",
        "unverified"
      ]
    },
    "availability": {
      "enum": [
        "current_as_documented",
        "limited",
        "retired",
        "unknown"
      ]
    },
    "repeatable": {
      "type": [
        "string",
        "boolean"
      ],
      "enum": [
        "yes",
        "no",
        "unknown",
        true,
        false
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "title",
          "url"
        ],
        "properties": {
          "type": {
            "enum": [
              "official",
              "community",
              "archived"
            ]
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
