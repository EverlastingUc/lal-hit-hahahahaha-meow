    {
      "id": "super-contributor",
      "name": "Super Contributor",
      "system": "achievement",
      "category": "community",
      "description": "Recognises sustained high-ranking, high-quality contributions in a community.",
      "unlock": {
        "summary": "Be in the top 1% of posters or commenters, remain in the top 1% for five of the last twelve months, and maintain an upvote rate above 90%.",
        "criteria": [
          {
            "metric": "community_poster_or_commenter_rank",
            "operator": "top_percentile",
            "value": 1,
            "unit": "percent"
          },
          {
            "metric": "months_in_top_1_percent_within_last_12",
            "operator": "at_least",
            "value": 5,
            "unit": "months"
          },
          {
            "metric": "upvote_rate",
            "operator": "greater_than",
            "value": 90,
            "unit": "percent"
          }
        ]
      },
      "status": "official",
      "availability": "current_as_documented",
      "repeatable": "unknown",
      "sources": [
        {
          "type": "official",
          "title": "Community Achievements",
          "url": "https://support.reddithelp.com/hc/en-us/articles/25564722077588-Community-Achievements"
        }
      ],
      "notes": "Reddit's wording says top 1% of posters or commenters; this record preserves that wording."
    },
