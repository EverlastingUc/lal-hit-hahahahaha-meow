  "achievements": [
    {
      "id": "elder",
      "name": "Elder",
      "system": "achievement",
      "category": "community",
      "description": "Recognises long-term membership in a community.",
      "unlock": {
        "summary": "Be a member of any community for three years.",
        "criteria": [
          {
            "metric": "community_membership_duration",
            "operator": "at_least",
            "value": 3,
            "unit": "years"
          }
        ]
      },
      "status": "official",
      "availability": "current_as_documented",
      "repeatable": "unknown",
      "sources": [
        {
          "type": "official",
          "title": "Community Achievements",
          "url": "https://support.reddithelp.com/hc/en-us/articles/25564722077588-Community-Achievements"
        }
      ],
      "notes": "The official article says any community; do not assume every community is eligible."
    },
    {
